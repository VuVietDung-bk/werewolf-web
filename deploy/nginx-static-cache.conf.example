# Include inside the HTTPS server block after setting `root` to frontend/dist.
# Do not enable immutable caching for unversioned files or uploaded role icons.
location = /index.html {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
}

location ~ ^/assets/v[0-9]+/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# Vite emits content-hashed JS/CSS into /assets/.
location ~ "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$" {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}

location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
}
