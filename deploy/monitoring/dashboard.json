{
  "uid": "ma-soi-operations",
  "title": "Ma Sói · vận hành",
  "tags": ["ma-soi", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API đang hoạt động", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "min(up{job=\"ma_soi_api\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "PostgreSQL đang hoạt động", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "min(ma_soi_postgres_up)", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "Kết nối WebSocket", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(ma_soi_websocket_connections)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "Outbox chờ phát", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(ma_soi_outbox_pending)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "HTTP 5xx / giây", "gridPos": {"x": 0, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(ma_soi_http_requests_total{status_class=\"5xx\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "p95 lệnh thay đổi (giây)", "gridPos": {"x": 8, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(ma_soi_http_request_duration_seconds_bucket{method=~\"POST|PATCH|PUT|DELETE\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "Outbox cũ nhất (giây)", "gridPos": {"x": 16, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(ma_soi_outbox_oldest_age_seconds)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "Dung lượng PostgreSQL", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(ma_soi_database_size_bytes)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Nhịp worker / kết nối DB", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "max(ma_soi_outbox_worker_heartbeat_age_seconds)", "refId": "A", "legendFormat": "Worker age (s)"},
        {"expr": "max(ma_soi_database_connections)", "refId": "B", "legendFormat": "DB connections"}
      ],
      "fieldConfig": {"defaults": {}, "overrides": []}
    }
  ]
}
