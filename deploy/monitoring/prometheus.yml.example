global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/ma-soi-alerts.yml

scrape_configs:
  - job_name: ma_soi_api
    metrics_path: /internal/metrics
    scrape_timeout: 5s
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/ma-soi-metrics-token
    static_configs:
      - targets: ['api.internal:8000']
