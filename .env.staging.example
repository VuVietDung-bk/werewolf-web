# Replace these values in the staging environment. Never commit actual credentials.
DATABASE_URL=postgresql+psycopg://ma_soi:change_me@staging-db:5432/ma_soi
APP_ENV=staging
APP_ORIGINS=https://your-staging-host.example
REDIS_URL=redis://staging-redis:6379/0
# Set a long random secret in deployment; leave unset to disable /internal/metrics.
METRICS_TOKEN=replace_with_long_random_secret
# Required before API startup; use deployment secrets, not a checked-in key.
# CHAT_CURSOR_KEYS is a JSON object: {"chat0001":"URL_SAFE_BASE64_32_RANDOM_BYTES"}
# Keep the previous key during rotation for at least the 1-hour token TTL + clock skew.
CHAT_CURSOR_KEYS=
CHAT_CURSOR_ACTIVE_KEY=chat0001
